{
  "name": "ERHW - Road Safety Platform",
  "short_name": "ERHW",
  "id": "com.erhw.road-safety",
  "description": "ERHW - Road Safety Platform for reporting hazards and safe driving. Report accidents, road damage, traffic, weather conditions, and construction work in real-time.",
