  "shortcuts": [
    {
      "name": "بلاغ جديد",
      "short_name": "بلاغ",
      "description": "أرسل بلاغ عن خطر مروري",
      "url": "/index.html?screen=report",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "الخريطة",
      "short_name": "خريطة",
      "description": "عرض مخاطر الطريق على الخريطة",
      "url": "/index.html?screen=map",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "التنبيهات",
      "short_name": "تنبيهات",
      "description": "آخر التحذيرات المرورية",
      "url": "/index.html?screen=alerts",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+erhw",
      "url": "/index.html?report=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "ERHW Road Status",
      "short_name": "Road Status",
      "description": "Quick view of nearby road hazards",
      "tag": "erhw-road-status",
      "template": "erhw-widget",
      "ms_ac_template": "erhw-widget",
      "data": "/index.html?widget=road-status"
    }
  ],
  "prefer_related_applications": false,
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce77e396"
}